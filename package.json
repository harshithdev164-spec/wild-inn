{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-sitemap.cjs && node scripts/build-reels-data.mjs && tsx scripts/build-pricing.ts && vite build",
    "prebuild:pricing": "tsx scripts/build-pricing.ts",
    "preview": "vite preview",
    "serve": "node serve.js",
    "db:check": "node scripts/check-db.mjs",
    "db:coupons": "node scripts/seed-coupons.mjs",
    "db:packages": "tsx scripts/build-pricing.ts && node scripts/seed-packages.mjs",
    "reels:sync": "node scripts/seed-reels.mjs db/reels.json",
    "reels:sync:prune": "node scripts/seed-reels.mjs db/reels.json --prune",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "@neondatabase/serverless": "^0.10.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
